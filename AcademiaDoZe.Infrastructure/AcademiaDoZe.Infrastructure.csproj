	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="MySql.Data" Version="26.7.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AcademiadoZE.Domain\AcademiadoZE.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Scripts\script_mysql.sql" />
		<EmbeddedResource Include="Scripts\script_sqlite.sql" />
